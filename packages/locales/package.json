{
  "name": "@charton/locales",
  "version": "0.1.0",
  "description": "Opt-in translations of the @charton/core and @charton/ui built-in text, one entry per language.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chart-on/charton.git",
    "directory": "packages/locales"
  },
  "homepage": "https://github.com/chart-on/charton#readme",
  "bugs": "https://github.com/chart-on/charton/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "browserslist": ["chrome >= 111", "edge >= 111", "firefox >= 114", "safari >= 16.4", "ios_saf >= 16.4"],
  "exports": {
    "./de-DE": {
      "types": "./dist/de-DE.d.ts",
      "import": "./dist/de-DE.js",
      "default": "./dist/de-DE.js"
    },
    "./es-ES": {
      "types": "./dist/es-ES.d.ts",
      "import": "./dist/es-ES.js",
      "default": "./dist/es-ES.js"
    },
    "./fr-FR": {
      "types": "./dist/fr-FR.d.ts",
      "import": "./dist/fr-FR.js",
      "default": "./dist/fr-FR.js"
    },
    "./id-ID": {
      "types": "./dist/id-ID.d.ts",
      "import": "./dist/id-ID.js",
      "default": "./dist/id-ID.js"
    },
    "./ja-JP": {
      "types": "./dist/ja-JP.d.ts",
      "import": "./dist/ja-JP.js",
      "default": "./dist/ja-JP.js"
    },
    "./zh-CN": {
      "types": "./dist/zh-CN.d.ts",
      "import": "./dist/zh-CN.js",
      "default": "./dist/zh-CN.js"
    },
    "./zh-TW": {
      "types": "./dist/zh-TW.d.ts",
      "import": "./dist/zh-TW.js",
      "default": "./dist/zh-TW.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p ."
  },
  "peerDependencies": {
    "@charton/core": "workspace:^"
  },
  "devDependencies": {
    "@charton/core": "workspace:^",
    "@charton/ui": "workspace:^"
  }
}
