{
  "name": "charton-example-svelte-bundler",
  "version": "0.0.0",
  "private": true,
  "description": "Example: the chart widget in a client-rendered app using @chart-on/svelte built with a bundler.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build"
