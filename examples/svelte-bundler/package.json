    "@chart-on/core": "workspace:^",
    "@chart-on/svelte": "workspace:^",
    "@chart-on/ui": "workspace:^",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte-check": "^4.7.6"
  }
}
