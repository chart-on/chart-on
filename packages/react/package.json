{
  "name": "@chart-on/react",
  "version": "0.1.2",
  "description": "Components and hooks that mount @chart-on/core charts and @chart-on/ui shells in component-based apps, with server rendering support.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chart-on/chart-on.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/chart-on/chart-on#readme",
  "bugs": "https://github.com/chart-on/chart-on/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "browserslist": ["chrome >= 111", "edge >= 111", "firefox >= 114", "safari >= 16.4", "ios_saf >= 16.4"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./shell": {
      "types": "./dist/shell.d.ts",
      "import": "./dist/shell.js",
      "default": "./dist/shell.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p ."
  },
  "peerDependencies": {
    "@chart-on/core": "workspace:^",
    "@chart-on/ui": "workspace:^",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@chart-on/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chart-on/core": "workspace:^",
    "@chart-on/ui": "workspace:^",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
