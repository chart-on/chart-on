{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@chart-on/core": ["./packages/core/src/index.ts"],
      "@chart-on/core/internal": ["./packages/core/src/internal.ts"],
      "@chart-on/core/testing": ["./packages/core/src/testing.ts"],
      "@chart-on/ui": ["./packages/ui/src/index.ts"],
      "@chart-on/ui/templates": ["./packages/ui/src/templates.ts"],
      "@chart-on/react": ["./packages/react/src/index.ts"],
      "@chart-on/react/shell": ["./packages/react/src/shell.ts"],
      "@chart-on/vue": ["./packages/vue/src/index.ts"],
      "@chart-on/vue/shell": ["./packages/vue/src/shell.ts"],
      "@chart-on/svelte": ["./packages/svelte/src/index.ts"],
      "@chart-on/svelte/shell": ["./packages/svelte/src/shell.ts"],
      "@chart-on/ta": ["./packages/ta/src/index.ts"],
      "@chart-on/indicators": ["./packages/indicators/src/index.ts"],
      "@chart-on/locales/*": ["./packages/locales/src/*"]
    }
  }
}
