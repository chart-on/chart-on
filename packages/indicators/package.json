{
  "name": "@chart-on/indicators",
  "version": "0.1.0",
  "description": "Built-in chart indicators (SMA, EMA, Bollinger Bands, VWAP, RSI, MACD, volume MA, cumulative volume, Keltner, Donchian, Supertrend, Ichimoku, ATR, Stochastic, Stoch RSI, DMI/ADX, OBV, moon phases) for @chart-on/core.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chart-on/charton.git",
    "directory": "packages/indicators"
  },
  "homepage": "https://github.com/chart-on/charton#readme",
  "bugs": "https://github.com/chart-on/charton/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "browserslist": ["chrome >= 111", "edge >= 111", "firefox >= 114", "safari >= 16.4", "ios_saf >= 16.4"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@chart-on/ta": "workspace:^"
  },
  "peerDependencies": {
    "@chart-on/core": "workspace:^"
  },
  "devDependencies": {
    "@chart-on/core": "workspace:^"
  }
}
