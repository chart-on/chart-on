{
  "name": "@chart-on/ui",
  "version": "0.1.0",
  "description": "Config-driven toolbar, drawing tool rail and shell for @chart-on/core.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chart-on/chart-on.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/chart-on/chart-on#readme",
  "bugs": "https://github.com/chart-on/chart-on/issues",
  "type": "module",
  "sideEffects": ["*.css"],
  "engines": {
    "node": ">=22"
  },
  "browserslist": ["chrome >= 111", "edge >= 111", "firefox >= 114", "safari >= 16.4", "ios_saf >= 16.4"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./templates": {
      "types": "./dist/templates.d.ts",
      "import": "./dist/templates.js",
      "default": "./dist/templates.js"
    },
    "./style.css": {
      "types": "./dist/style.css.d.ts",
      "default": "./dist/style.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "vite build && vite build -c vite.addons.config.ts && vite build -c vite.browser.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p ."
  },
  "peerDependencies": {
    "@chart-on/core": "workspace:^"
  },
  "devDependencies": {
    "@chart-on/core": "workspace:^",
    "happy-dom": "^21.0.1",
    "lucide": "^1.55.0"
  }
}
